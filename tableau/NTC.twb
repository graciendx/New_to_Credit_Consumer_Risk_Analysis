          <datasources>
            <datasource caption="NTC_Consumer_Credit_Data" name="federated.1joxdpd0cp2m3u19vmn9b18teegu"/>
          </datasources>
          <datasource-dependencies datasource="federated.1joxdpd0cp2m3u19vmn9b18teegu">
            <column datatype="integer" name="[Accounts]" role="measure" type="quantitative"/>
            <column caption="Asset Band" datatype="string" name="[Asset_Band]" role="dimension" type="nominal"/>
            <column caption="Observed charge-off share" datatype="real" default-format="p0.00%" name="[Calculation_42221264209735681]" role="measure" type="quantitative">
              <calculation class="tableau" formula="IF SUM([Accounts]) &gt; 0 THEN SUM([Observed_Chargeoff]) / SUM([Accounts]) END"/>
            </column>
            <column caption="Illustrative 20% observed-share comparison" datatype="string" name="[Calculation_42221264210087938]" role="measure" type="nominal">
              <calculation class="tableau" formula="IF [Calculation_42221264209735681] &gt;= 0.2 THEN &quot;Observed share ≥20% (illustrative)&quot; ELSE &quot;Observed share &lt;20% (illustrative)&quot; END"/>
            </column>
            <column caption="Observed Charge-off Indicator" datatype="integer" name="[Observed_Chargeoff]" role="measure" type="quantitative"/>
            <column caption="Utilization Band" datatype="string" name="[Utilization_Band]" role="dimension" type="nominal"/>
            <column-instance column="[Asset_Band]" derivation="None" name="[none:Asset_Band:nk]" pivot="key" type="nominal"/>
